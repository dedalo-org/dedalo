# Loads the pinned toolchain automatically on `cd`, via direnv + nix.
#   nix profile install nixpkgs#direnv  &&  direnv allow
if ! has nix_direnv_version || ! nix_direnv_version 3.0.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.0/direnvrc" "sha256-21TMnI2xWX7HkSTjFFri2UaohXVj9Wzjs3nueLp2Nzg="
fi
use flake
