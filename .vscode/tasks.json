{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "cargo",
      "command": "test",
      "args": ["--workspace", "--all-features"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "clippy",
      "type": "cargo",
      "command": "clippy",
      "args": ["--workspace", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "fmt",
      "type": "cargo",
      "command": "fmt",
      "args": ["--all"],
      "problemMatcher": []
    },
    {
      "label": "docs",
      "type": "cargo",
      "command": "doc",
      "args": ["--workspace", "--no-deps", "--all-features", "--open"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "nix flake check",
      "type": "shell",
      "command": "nix flake check --print-build-logs",
      "problemMatcher": []
    }
  ]
}
