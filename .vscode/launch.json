{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "dedalo (args from prompt)",
      "cargo": {
        "args": ["build", "--bin=dedalo", "--package=dedalo"],
        "filter": { "name": "dedalo", "kind": "bin" }
      },
      "args": ["${input:dedaloArgs}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug core unit tests",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=dedalo-core"],
        "filter": { "name": "dedalo-core", "kind": "lib" }
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug end-to-end tests",
      "cargo": {
        "args": ["test", "--no-run", "--test=end_to_end", "--package=dedalo-core"],
        "filter": { "name": "end_to_end", "kind": "test" }
      },
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "dedaloArgs",
      "type": "promptString",
      "description": "Arguments for the dedalo binary",
      "default": "status"
    }
  ]
}
